openai = None
anthropic_client = None

def get_openai_client():
    """
    OpenAI API istemcisini döndürür. 
    Önce çevre değişkenlerinden anahtar kullanılır, yoksa özel anahtar denenebilir.
    """
    global openai
    try:
        if not openai:
            # Önce çevre değişkenindeki anahtarı kullan
            if openai_api_key:
                openai = OpenAI(api_key=openai_api_key)
            # Çevre değişkeni yoksa fallback anahtarı dene
            elif OPENAI_FALLBACK_KEY:
                openai = OpenAI(api_key=OPENAI_FALLBACK_KEY)
        return openai
    except Exception as e:
        print(f"OpenAI istemcisi oluşturma hatası: {str(e)}")
        return None

def get_anthropic_client():
    """
    Anthropic (Claude) API istemcisini döndürür.
    Sadece çevre değişkenlerinden anahtar kullanılır.
    """
    global anthropic_client
    try:
        if not anthropic_client and anthropic_api_key:
            anthropic_client = Anthropic(api_key=anthropic_api_key)
        return anthropic_client
    except Exception as e:
        print(f"Anthropic istemcisi oluşturma hatası: {str(e)}")
        return None

def get_perplexity_url(query_text):
    """
    Perplexity internet araması için URL oluşturur
    
    Args:
        query_text: Arama sorgusu metni
        
    Returns:
        Perplexity URL'si
    """
    # Sorguyu URL uyumlu hale getir
    import urllib.parse
    encoded_query = urllib.parse.quote_plus(query_text)
    
    # Perplexity arama URL'sini oluştur
    perplexity_url = f"https://www.perplexity.ai/search?q={encoded_query}"
    
    return perplexity_url

# Not: Model sabitleri en üstte tanımlandı

# Türkiye saat dilimi tanımlaması
TURKIYE_SAAT_DILIMI = pytz.timezone('Europe/Istanbul')  # Bu, UTC+3 ile aynıdır

# UTC zamanını Türkiye saatine dönüştüren yardımcı fonksiyon
def utc_to_turkiye_saati(utc_datetime):
    """
    UTC zamanını Türkiye saatine (UTC+3) dönüştürür.
    
    Args:
        utc_datetime: Dönüştürülecek UTC zaman nesnesi
        
    Returns:
        Türkiye saatine dönüştürülmüş datetime nesnesi
    """
    if utc_datetime is None:
        return None
    
    # datetime nesnesi timezone aware değilse, UTC kabul et
    if utc_datetime.tzinfo is None:
        utc_datetime = utc_datetime.replace(tzinfo=pytz.UTC)
    
    # Türkiye saatine dönüştür
    turkiye_saati = utc_datetime.astimezone(TURKIYE_SAAT_DILIMI)
    return turkiye_saati
    
# Datetime nesnesini Türkiye saatine göre formatlanmış string'e dönüştüren fonksiyon
def format_turkiye_saati(datetime_obj, format_str="%d.%m.%Y %H:%M"):
    """
    Datetime nesnesini Türkiye saatine dönüştürüp belirtilen formatta string olarak döndürür.
    
    Args:
        datetime_obj: Dönüştürülecek datetime nesnesi
        format_str: Çıktı formatı (varsayılan: '31.03.2025 15:30')
        
    Returns:
        Formatlanmış tarih-saat string'i
    """
    if datetime_obj is None:
        return ""
    
    turkiye_saati = utc_to_turkiye_saati(datetime_obj)
    if turkiye_saati is None:
        return ""
        
    return turkiye_saati.strftime(format_str)

# Global template context processor
@app.context_processor
def inject_now():
    """
    Şablon içinde kullanılacak global değişkenleri tanımlar:
    - now: Şu anki UTC zaman
    - now_tr: Şu anki Türkiye saati
    - utc_to_tr: UTC'den Türkiye saatine dönüştürme fonksiyonu
    - format_tr_saati: Datetime'ı formatlanmış Türkiye saati string'ine dönüştürme fonksiyonu
    """
    now_utc = datetime.datetime.now(pytz.UTC)
    now_tr = utc_to_turkiye_saati(now_utc)
    
    # ISO format şablon fonksiyonu (YYYY-MM-DDTHH:MM:SS formatlı string döndürür)
    def isoformat(dt):
        if dt is None:
            return ""
        return dt.isoformat()
        
    return {
        'now': now_utc,
        'now_tr': now_tr,
        'utc_to_tr': utc_to_turkiye_saati,
        'format_tr_saati': format_turkiye_saati,
        'isoformat': isoformat
    }

# Gübre formülasyonu açıklama API
@app.route('/api/gubre-acikla', methods=['POST'])
def gubre_acikla():
    try:
        data = request.json
        formulasyon = data.get('formulasyon', '')
        
        if not formulasyon:
            return jsonify({"error": "Gübre formülasyonu belirtilmedi"}), 400
            
        # 1. Adım: Claude ile açıklama almayı dene
        try:
            aciklama = claude_gubre_aciklamasi_olustur(formulasyon)
            # Eğer Claude yanıt döndürürse ve boş değilse
            if aciklama and aciklama.strip():
                print(f"Claude API başarılı: {len(aciklama)} karakter yanıt alındı")
                return jsonify({"aciklama": aciklama, "kaynak": "Claude"})
            else:
                # Claude boş yanıt döndürürse GPT-4o'ya geç
                print("Claude boş yanıt döndürdü, GPT-4o'ya geçiliyor")
                raise Exception("Claude boş yanıt döndürdü")
        except Exception as claude_error:
            print(f"Claude API hatası: {str(claude_error)}, GPT-4o'ya geçiliyor")
            
            # 2. Adım: GPT-4o ile açıklama almayı dene
            try:
                aciklama = openai_gubre_aciklamasi_olustur(formulasyon)
                # GPT-4o yanıt döndürürse ve boş değilse
                if aciklama and aciklama.strip():
                    print(f"GPT-4o API başarılı: {len(aciklama)} karakter yanıt alındı")
                    return jsonify({"aciklama": aciklama, "kaynak": "GPT-4o"})
                else:
                    # GPT-4o boş yanıt döndürürse Perplexity bağlantısı oluştur
                    print("GPT-4o boş yanıt döndürdü, Perplexity bağlantısı oluşturuluyor")
                    raise Exception("GPT-4o boş yanıt döndürdü")
            except Exception as openai_error:
                print(f"GPT-4o API hatası: {str(openai_error)}, Perplexity bağlantısı oluşturuluyor")
                
                # 3. Adım: Perplexity bağlantısı oluştur
                perplexity_url = f"https://www.perplexity.ai/search/{formulasyon}-gübre-ne-işe-yarar"
                perplexity_mesaj = f"Claude ve GPT-4o bilgi veremedi. Perplexity üzerinden detaylı bilgiye ulaşabilirsin: \n\n[{formulasyon} gübresi hakkında bilgi](https://www.perplexity.ai/search/{formulasyon}-gübre-ne-işe-yarar)"
                
                # Yerel yedek mekanizma olarak temel bir açıklama oluştur
                try:
                    yerel_aciklama = yerel_gubre_aciklamasi_olustur(formulasyon)
                    aciklama = f"{yerel_aciklama}\n\n---\n\n{perplexity_mesaj}"
                except:
                    aciklama = perplexity_mesaj
                
                return jsonify({"aciklama": aciklama, "kaynak": "Yerel+Perplexity", "perplexity_url": perplexity_url})
    except Exception as e:
        print(f"Gübre açıklama hatası: {str(e)}")
        return jsonify({"error": f"Gübre açıklaması alınamadı: {str(e)}"}), 500

# Claude API ile gübre analizi
def claude_gubre_aciklamasi_olustur(formulasyon):
    """
    Claude API kullanarak gübre formülasyonunu açıklar.
    """
    try:
        # API anahtarı kontrolü
        client = get_anthropic_client()
        if not client:
            raise Exception("Claude API anahtarı mevcut değil")
        
        # Claude API çağrısı
        response = client.messages.create(
            model=CLAUDE_MODEL,  # the newest Anthropic model is "claude-3-5-sonnet-20241022" which was released October 22, 2024
            max_tokens=1000,
            temperature=0.5,
            system="Deneyimli bir tarım mühendisi olarak, gübrelerin içerikleri, kullanımları ve etkileri hakkında kapsamlı bilgiye sahipsin. Yanıtların teknik açıdan doğru ancak anlaşılır olmalı. Asla ekstra açıklama veya özür mesajları ekleme.",
            messages=[
                {
                    "role": "user", 
                    "content": f"""
Sen deneyimli bir tarım mühendisisin.
Aşağıdaki gübre formülasyonunun hangi elementleri içerdiğini, ne işe yaradığını, ne zaman kullanılacağını ve bitkiye etkisini sade ve kısa şekilde açıkla. Markdown formatında yanıt ver:

Formülasyon: {formulasyon}

Yanıtını oluştururken sadece formülasyonla ilgili bilgi ver, 'json' kelimesini ekleme, ve yanıtını hiçbir şekilde 'ben bilemiyorum' veya 'bilgi yetersiz' gibi ifadelerle sonlandırma. Kendine özgün bilgiler üretebilirsin."""
                }
            ]
        )
        
        # Yanıtı al ve döndür
        return response.content[0].text
    except Exception as e:
        print(f"Claude API hatası: {str(e)}")
        # Hata olursa dışarıdan yakalanamaz
        raise

