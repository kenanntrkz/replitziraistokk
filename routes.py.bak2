anthropic_api_key = os.environ.get("ANTHROPIC_API_KEY", "")

# API model isimleri
CLAUDE_MODEL = "claude-3-5-sonnet-20241022"  # the newest Anthropic model is "claude-3-5-sonnet-20241022" which was released October 22, 2024
