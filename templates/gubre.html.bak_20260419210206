{% extends 'layout.html' %}

{% block content %}
<div class="row mb-4 align-items-center">
    <div class="col">
        <h1>
            <i class="fas fa-seedling me-2"></i> Gübre Yönetimi
        </h1>
        <p class="lead mb-0">Gübre ekle, düzenle ve stokları takip et.</p>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#katalogEkleModal">
            <i class="fas fa-book-medical me-1"></i> Kataloğa Ekle
        </button>
    </div>
</div>

<!-- Kataloğa Ekle Modal -->
<div class="modal fade" id="katalogEkleModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-book-medical me-2"></i>Ürünü Kataloğa Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Stok girmeden sadece ürün bilgilerini kataloğa kaydedebilirsin.</p>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ürün Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="kat_ad" placeholder="Örn: NUTRI GROW PZn">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Kategori</label>
                        <select class="form-select" id="kat_kategori">
                            <option value="">-- Seçiniz --</option>
                            <option value="Yaprak Gübresi">Yaprak Gübresi</option>
                            <option value="Sıvı Damlama">Sıvı Damlama</option>
                            <option value="Toz Damlama">Toz Damlama</option>
                            <option value="Mikro Element">Mikro Element</option>
                            <option value="Biyostimülant">Biyostimülant</option>
                            <option value="Özel Seri">Özel Seri</option>
                            <option value="Toprak Gübresi">Toprak Gübresi</option>
                            <option value="Diğer">Diğer</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Formülasyon (N-P-K)</label>
                        <input type="text" class="form-control" id="kat_formulasyon" placeholder="Örn: 18-18-18 veya %30 P2O5">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Kullanım Alanı / Not</label>
                        <input type="text" class="form-control" id="kat_kullanim" placeholder="Örn: Bağ, narenciye...">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><i class="fas fa-leaf text-success"></i> Yaprak Dozu</label>
                        <div class="input-group">
                            <input type="number" step="0.01" class="form-control" id="kat_yaprak_dozu" placeholder="250">
                            <span class="input-group-text">ml/100lt</span>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><i class="fas fa-tint text-primary"></i> Damlama Dozu</label>
                        <div class="input-group">
                            <input type="number" step="0.01" class="form-control" id="kat_damlama_dozu" placeholder="3">
                            <span class="input-group-text">lt/da</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" id="kat_aciklama" rows="2" placeholder="Ürün hakkında kısa not..."></textarea>
                    </div>
                </div>
                <div id="katalogEkleMsg" class="d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success" id="katalogEkleKaydet">
                    <i class="fas fa-save me-1"></i> Kataloğa Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Yeni Gübre Ekleme Formu -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Yeni Gübre Ekle</h5>
    </div>
    <div class="card-body">

        <!-- ADIM 1: Katalogdan Seç veya Manuel -->
        <div class="mb-4">
            <label class="form-label fw-bold"><i class="fas fa-search me-1"></i>Katalogdan Ara</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-seedling"></i></span>
                <select class="form-select" id="katalogSec" style="max-width:500px;">
                    <option value="">-- Katalogdan seç (otomatik doldurmak için) --</option>
                </select>
                <button type="button" class="btn btn-outline-secondary" id="katalogTemizle">
                    <i class="fas fa-times"></i> Temizle
                </button>
            </div>
            <small class="text-muted">Katalogda yoksa formu manuel doldur — otomatik kaydedilir.</small>
            <div id="katalogBilgi" class="alert alert-success mt-2 py-2 d-none" style="font-size:0.85rem;"></div>
        </div>

        <hr>

        <form method="POST" action="{{ url_for('gubreler') }}" id="gubreForm">
            <input type="hidden" name="katalog_id" id="katalog_id_hidden">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ad" class="form-label">Gübre Adı <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="ad" name="ad" required placeholder="Ürün adını gir veya katalogdan seç">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="kategori" class="form-label">Kategori</label>
                    <select class="form-select" id="kategori" name="kategori">
                        <option value="">-- Seçiniz --</option>
                        <option value="Yaprak Gübresi">Yaprak Gübresi</option>
                        <option value="Sıvı Damlama">Sıvı Damlama</option>
                        <option value="Toz Damlama">Toz Damlama</option>
                        <option value="Mikro Element">Mikro Element</option>
                        <option value="Biyostimülant">Biyostimülant</option>
                        <option value="Özel Seri">Özel Seri</option>
                        <option value="Toprak Gübresi">Toprak Gübresi</option>
                        <option value="Diğer">Diğer</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="formulasyon" class="form-label">Formülasyon (N-P-K)</label>
                    <input type="text" class="form-control" id="formulasyon" name="formulasyon" placeholder="Örn: 18-18-18">
                    <button type="button" class="btn btn-sm btn-outline-info mt-1" id="gubreAciklaBtn">
                        <i class="fas fa-robot"></i> AI ile Açıklama Al
                    </button>
                    <div id="gubreAciklama" class="mt-2" style="display:none;"></div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="kullanim_alani" class="form-label">Kullanım Alanı / Notlar</label>
                    <textarea class="form-control" id="kullanim_alani" name="kullanim_alani" rows="2" placeholder="Hangi bitkiler, nasıl kullanılır..."></textarea>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-bold text-success"><i class="fas fa-warehouse me-1"></i>Stok Miktarı <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" class="form-control border-success" id="miktar" name="miktar" required placeholder="Elimde ne kadar var">
                </div>
                <div class="col-md-3 mb-3">
                    <label for="birim" class="form-label fw-bold text-success">Birim <span class="text-danger">*</span></label>
                    <select class="form-select border-success" id="birim" name="birim" required>
                        <option value="kg">kg</option>
                        <option value="lt">lt</option>
                        <option value="gr">gr</option>
                        <option value="ton">ton</option>
                        <option value="ml">ml</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="uygulama_dozu" class="form-label">
                        <i class="fas fa-tint text-primary"></i> Damlama Dozu <small class="text-muted">(lt/da)</small>
                    </label>
                    <div class="input-group">
                        <input type="number" step="0.01" class="form-control" id="uygulama_dozu" name="uygulama_dozu" placeholder="Örn: 3">
                        <span class="input-group-text">lt/da</span>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="yaprak_dozu" class="form-label">
                        <i class="fas fa-leaf text-success"></i> Yaprak Dozu <small class="text-muted">(ml/100lt)</small>
                    </label>
                    <div class="input-group">
                        <input type="number" step="0.01" class="form-control" id="yaprak_dozu" name="yaprak_dozu" placeholder="Örn: 250">
                        <span class="input-group-text">ml/100lt</span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="not_bilgisi" class="form-label">Not</label>
                    <textarea class="form-control" id="not_bilgisi" name="not_bilgisi" rows="2"></textarea>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-plus"></i> Gübre Ekle
            </button>
        </form>
    </div>
</div>

<!-- Gübre Listesi -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Mevcut Gübreler ({{ gubreler|length }})</h5>
    </div>
    <div class="card-body">
        {% if gubreler %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Gübre Adı</th>
                        <th>Kategori</th>
                        <th>Formülasyon</th>
                        <th>Stok</th>
                        <th>Kullanım Alanı</th>
                        <th>Damlama Dozu</th><th>Yaprak Dozu</th>
                        <th>Not</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    {% for gubre in gubreler %}
                    <tr>
                        <td><strong>{{ gubre.ad }}</strong></td>
                        <td>{% if gubre.kategori %}<span class="badge bg-success">{{ gubre.kategori }}</span>{% else %}-{% endif %}</td>
                        <td>{{ gubre.formulasyon or '-' }}</td>
                        <td>{{ gubre.miktar }} {{ gubre.birim }}</td>
                        <td>{{ gubre.kullanim_alani or '-' }}</td>
                        <td>{% if gubre.uygulama_dozu %}{{ gubre.uygulama_dozu }} lt/da{% else %}-{% endif %}</td>
                        <td>{% if gubre.yaprak_dozu %}{{ gubre.yaprak_dozu }} ml/100lt{% else %}-{% endif %}</td>
                        <td>{{ gubre.not_bilgisi or '-' }}</td>
                        <td>
                            <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#gubreDuzenleModal{{ gubre.id }}">
                                <i class="fas fa-edit"></i>
                            </button>
                            <form method="POST" action="{{ url_for('gubre_sil', id=gubre.id) }}" style="display:inline" onsubmit="return confirm('Bu gübreyi silmek istediğinize emin misiniz?')">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>

                    <!-- Gübre Düzenleme Modal -->
                    <div class="modal fade" id="gubreDuzenleModal{{ gubre.id }}" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Gübre Düzenle: {{ gubre.ad }}</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form method="POST" action="{{ url_for('gubre_duzenle', id=gubre.id) }}">
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label">Gübre Adı</label>
                                            <input type="text" class="form-control" name="ad" value="{{ gubre.ad }}" required>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Formülasyon (N-P-K)</label>
                                            <input type="text" class="form-control" name="formulasyon" value="{{ gubre.formulasyon or '' }}">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Kategori</label>
                                            <select class="form-select" name="kategori">
                                                <option value="">-- Seçiniz --</option>
                                                <option value="Yaprak Gübresi" {% if gubre.kategori == "Yaprak Gübresi" %}selected{% endif %}>Yaprak Gübresi</option>
                                                <option value="Sıvı Damlama" {% if gubre.kategori == "Sıvı Damlama" %}selected{% endif %}>Sıvı Damlama</option>
                                                <option value="Toz Damlama" {% if gubre.kategori == "Toz Damlama" %}selected{% endif %}>Toz Damlama</option>
                                                <option value="Mikro Element" {% if gubre.kategori == "Mikro Element" %}selected{% endif %}>Mikro Element</option>
                                                <option value="Biyostimülant" {% if gubre.kategori == "Biyostimülant" %}selected{% endif %}>Biyostimülant</option>
                                                <option value="Özel Seri" {% if gubre.kategori == "Özel Seri" %}selected{% endif %}>Özel Seri</option>
                                                <option value="Toprak Gübresi" {% if gubre.kategori == "Toprak Gübresi" %}selected{% endif %}>Toprak Gübresi</option>
                                                <option value="Diğer" {% if gubre.kategori == "Diğer" %}selected{% endif %}>Diğer</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Stok Miktarı</label>
                                            <input type="number" step="0.01" class="form-control" name="miktar" value="{{ gubre.miktar }}" required>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Birim</label>
                                            <select class="form-select" name="birim" required>
                                                <option value="kg" {% if gubre.birim == 'kg' %}selected{% endif %}>kg</option>
                                                <option value="lt" {% if gubre.birim == 'lt' %}selected{% endif %}>lt</option>
                                                <option value="gr" {% if gubre.birim == 'gr' %}selected{% endif %}>gr</option>
                                                <option value="ton" {% if gubre.birim == 'ton' %}selected{% endif %}>ton</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Kullanım Alanı</label>
                                            <input type="text" class="form-control" name="kullanim_alani" value="{{ gubre.kullanim_alani or '' }}">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label"><i class="fas fa-tint text-primary"></i> Damlama Dozu <small class="text-muted">(lt/da)</small></label>
                                            <div class="input-group">
                                                <input type="number" step="0.01" class="form-control" name="uygulama_dozu" value="{{ gubre.uygulama_dozu or '' }}" placeholder="Örn: 3">
                                                <span class="input-group-text">lt/da</span>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label"><i class="fas fa-leaf text-success"></i> Yaprak Dozu <small class="text-muted">(ml/100lt su)</small></label>
                                            <div class="input-group">
                                                <input type="number" step="0.01" class="form-control" name="yaprak_dozu" value="{{ gubre.yaprak_dozu or '' }}" placeholder="Örn: 250">
                                                <span class="input-group-text">ml/100lt</span>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Not</label>
                                            <textarea class="form-control" name="not_bilgisi" rows="2">{{ gubre.not_bilgisi or '' }}</textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                        <button type="submit" class="btn btn-primary">Kaydet</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Henüz gübre eklenmemiş. Yukarıdaki formu kullanarak gübre ekleyebilirsiniz.
        </div>
        {% endif %}
    </div>
</div>

{% block scripts %}
<script>

// === KATALOĞA EKLE MODAL ===
document.getElementById('katalogEkleKaydet').addEventListener('click', function() {
    const ad = document.getElementById('kat_ad').value.trim();
    if (!ad) {
        const msg = document.getElementById('katalogEkleMsg');
        msg.className = 'alert alert-danger';
        msg.textContent = 'Ürün adı zorunlu!';
        msg.classList.remove('d-none');
        return;
    }
    const btn = this;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Kaydediliyor...';

    fetch('/api/gubre-katalog/ekle', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
            ad: ad,
            kategori: document.getElementById('kat_kategori').value,
            formulasyon: document.getElementById('kat_formulasyon').value,
            kullanim_alani: document.getElementById('kat_kullanim').value,
            yaprak_dozu: parseFloat(document.getElementById('kat_yaprak_dozu').value) || null,
            uygulama_dozu: parseFloat(document.getElementById('kat_damlama_dozu').value) || null,
            aciklama: document.getElementById('kat_aciklama').value,
        })
    })
    .then(r => r.json())
    .then(data => {
        const msg = document.getElementById('katalogEkleMsg');
        if (data.success) {
            msg.className = 'alert alert-success';
            msg.innerHTML = '<i class="fas fa-check-circle me-1"></i> <strong>' + ad + '</strong> kataloğa eklendi! Artık stoğa eklerken listeden seçebilirsin.';
            msg.classList.remove('d-none');
            btn.innerHTML = '<i class="fas fa-check me-1"></i> Kaydedildi';
            // Dropdown listesini güncelle
            fetch('/api/gubre-katalog')
                .then(r => r.json())
                .then(liste => {
                    const sel = document.getElementById('katalogSec');
                    sel.innerHTML = '<option value="">-- Katalogdan seç (otomatik doldurmak için) --</option>';
                    const gruplar = {};
                    liste.forEach(u => {
                        const k = u.kategori || 'Diğer';
                        if (!gruplar[k]) gruplar[k] = [];
                        gruplar[k].push(u);
                    });
                    Object.keys(gruplar).sort().forEach(kat => {
                        const grp = document.createElement('optgroup');
                        grp.label = kat;
                        gruplar[kat].forEach(u => {
                            const opt = document.createElement('option');
                            opt.value = u.id;
                            opt.textContent = u.ad;
                            grp.appendChild(opt);
                        });
                        sel.appendChild(grp);
                    });
                });
            // Formu temizle
            setTimeout(() => {
                ['kat_ad','kat_formulasyon','kat_kullanim','kat_yaprak_dozu','kat_damlama_dozu','kat_aciklama'].forEach(id => {
                    document.getElementById(id).value = '';
                });
                document.getElementById('kat_kategori').selectedIndex = 0;
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save me-1"></i> Kataloğa Kaydet';
            }, 2000);
        } else {
            msg.className = 'alert alert-danger';
            msg.textContent = 'Hata: ' + (data.error || 'Bilinmeyen hata');
            msg.classList.remove('d-none');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save me-1"></i> Kataloğa Kaydet';
        }
    });
});

// === GROWWAY KATALOG OTOMATIK DOLDURMA ===
let katalogData = [];

// Sayfa yüklenince katalog listesini çek
fetch('/api/gubre-katalog')
    .then(r => r.json())
    .then(data => {
        katalogData = data;
        const sel = document.getElementById('katalogSec');
        // Kategorilere göre grupla
        const gruplar = {};
        data.forEach(u => {
            const k = u.kategori || 'Diğer';
            if (!gruplar[k]) gruplar[k] = [];
            gruplar[k].push(u);
        });
        Object.keys(gruplar).sort().forEach(kat => {
            const grp = document.createElement('optgroup');
            grp.label = kat;
            gruplar[kat].forEach(u => {
                const opt = document.createElement('option');
                opt.value = u.id;
                opt.textContent = u.ad;
                grp.appendChild(opt);
            });
            sel.appendChild(grp);
        });
    });

// Katalogdan seçilince formu otomatik doldur
document.getElementById('katalogSec').addEventListener('change', function() {
    const id = this.value;
    if (!id) return;
    fetch('/api/gubre-katalog/' + id)
        .then(r => r.json())
        .then(u => {
            document.getElementById('ad').value = u.ad || '';
            document.getElementById('formulasyon').value = u.formulasyon || '';
            document.getElementById('kullanim_alani').value = u.kullanim_alani || '';
            document.getElementById('katalog_id_hidden').value = u.id;

            // Kategori seç
            const katSel = document.getElementById('kategori');
            for (let i = 0; i < katSel.options.length; i++) {
                if (katSel.options[i].value === u.kategori) {
                    katSel.selectedIndex = i; break;
                }
            }

            // Doz bilgisi
            if (u.yaprak_dozu_min) {
                const doz = u.yaprak_dozu_min == u.yaprak_dozu_max
                    ? u.yaprak_dozu_min
                    : ((u.yaprak_dozu_min + u.yaprak_dozu_max) / 2).toFixed(0);
                document.getElementById('yaprak_dozu').value = doz;
            }
            if (u.damlama_dozu_min) {
                const doz = u.damlama_dozu_min == u.damlama_dozu_max
                    ? u.damlama_dozu_min
                    : ((u.damlama_dozu_min + u.damlama_dozu_max) / 2).toFixed(1);
                document.getElementById('uygulama_dozu').value = doz;
            }

            // Bilgi banner
            const bilgi = document.getElementById('katalogBilgi');
            bilgi.classList.remove('d-none');
            const kaynak = u.kaynak === 'growway'
                ? '<i class="fas fa-check-circle text-success"></i> Growway kataloğundan otomatik dolduruldu'
                : '<i class="fas fa-user text-info"></i> Manuel kayıttan dolduruldu';
            bilgi.innerHTML = kaynak + ' — <strong>' + u.ad + '</strong>. Sadece stok miktarını gir.';

            // Stok alanına odaklan
            document.getElementById('miktar').focus();
        });
});

// Temizle butonu
document.getElementById('katalogTemizle').addEventListener('click', function() {
    document.getElementById('katalogSec').value = '';
    document.getElementById('ad').value = '';
    document.getElementById('formulasyon').value = '';
    document.getElementById('kullanim_alani').value = '';
    document.getElementById('kategori').selectedIndex = 0;
    document.getElementById('yaprak_dozu').value = '';
    document.getElementById('uygulama_dozu').value = '';
    document.getElementById('katalog_id_hidden').value = '';
    document.getElementById('not_bilgisi').value = '';
    document.getElementById('katalogBilgi').classList.add('d-none');
});

// Form submit: katalogda yoksa otomatik kaydet
document.getElementById('gubreForm').addEventListener('submit', function(e) {
    const katalogId = document.getElementById('katalog_id_hidden').value;
    const ad = document.getElementById('ad').value.trim();
    // Katalogda yoksa ve ad varsa → kataloğa kaydet
    if (!katalogId && ad) {
        const payload = {
            ad: ad,
            kategori: document.getElementById('kategori').value,
            formulasyon: document.getElementById('formulasyon').value,
            yaprak_dozu: parseFloat(document.getElementById('yaprak_dozu').value) || null,
            uygulama_dozu: parseFloat(document.getElementById('uygulama_dozu').value) || null,
            kullanim_alani: document.getElementById('kullanim_alani').value,
        };
        // Fire-and-forget (form submit devam etsin)
        fetch('/api/gubre-katalog/ekle', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload)
        });
    }
});
</script>
